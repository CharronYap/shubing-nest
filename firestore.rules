rules_version = '2';
// 薯餅的小窩的 Firestore 規則（Firebase 專案 shubing-nest）。
// 2026-11-26 新增 nestRooms（去朋友家）和 nestRooms/{uid}/hearts（留愛心）兩段。
// 2026-11-26 第四版：小窩存檔多收 season（季節）、mail（信箱）、yard（門外小島）三個欄位；新增 nestGifts（送娃娃）一段。
// 上面兩行的改動已經在 2026-11-26 整份發布。
// 2026-11-26 第五版（已發布）：
//   nestRooms 公開資料多 want（願望清單）、yard（小島給朋友看的樣子）兩欄；
//   新的子集合 nestRooms/{uid}/book（訪客簿）、nestRooms/{uid}/water（幫忙澆水）；
//   新集合 nestStays（娃娃去朋友家過夜）、nestCards（明信片）；nestGifts 多一欄 msg（自己打的一句話）。
//   自己打的字都檢查是文字、有長度上限：訪客簿、小紙條、送娃娃 40 字，明信片 80 字。
//   2026-11-26 收緊：自己打的字（訪客簿、明信片、送娃娃的 msg）要「收的人自己的好友名單裡有寫的人」才寫得進去。
//   好友名單是每個人自己寫自己的，只看「任一邊加了對方」的話，陌生人把你加進他的名單就能寫字給你；
//   改成看收的人的名單，把對方從名單移除，他就寫不進來了。愛心、澆水、過夜、選寫好的句子送娃娃照舊任一邊都算。
// 2026-11-26 賺幣和新房間（已發布）：
//   小窩存檔 nestSaves 多收 earn（小遊戲今天幾局、誰在打工、里程碑、小店）一欄；
//   存檔和公開房間的 home 可以多兩間：kitchen（廚房）、attic（閣樓），可有可無，檢查跟原本三間一樣。
//   以上全部在 2026-11-26 整份發布。
// 2026-11-26 躲貓貓（已發布，2026-11-26 下午 4:36）：
//   nestRooms 公開資料多 hide 一欄 = {d 哪一隻, r 哪一間, f 家具的編號, day 哪天躲的}，每個值都檢查型別和長度；
//   新的子集合 nestRooms/{uid}/found/{日子_找的人} = {from, fromName, day, ok 有沒有找到, n 用了幾次 1～3}，
//   寫法跟 water 一樣：只有好友能建、一人一天一筆、不能改；主人能讀全部、能刪；找的人只能讀自己那一筆。
//   其他段落沒有動。這個檔案跟主控台上的一樣。
//   保險：規則被換回舊版時躲貓貓的讀寫會被擋，遊戲那邊安靜處理（js/hide.js、js/cloud.js saveRoom 會拿掉 hide 再寫）。
// 2026-11-27 全部都留（2026-11-27 14:50 已發布）：
//   新的子集合 nestSaves/{uid}/memo/{月份}、nestSaves/{uid}/mail/{月份}、nestSaves/{uid}/cards/{明信片編號}，三個都只有本人能讀寫。
//   放主存檔放不下的舊紀念冊、舊信、舊明信片。其他段落沒有動。說明在檔案最下面那一段。
// 2026-11-27 回信（2026-11-27 20:18 已發布）：
//   新集合 nestLetters/{自動編號} = {from, fromName, to, msg, re, d, t}：朋友送來的娃娃、過夜的日記、明信片、回信下面可以回一封信，只有字。
//   寫法跟 nestCards 一樣：寄的人是本人、不能寄給自己、收的人的好友名單裡要有寄的人；兩邊都讀得到、都能刪；不能改。其他段落沒有動。
// 2026-11-27 朋友聊天（還沒發布）：
//   新集合 nestChats/{兩個人的帳號排序後用 _ 接起來} = {u, t, f, sa, sb, x}（最後一則的時間、誰送的、兩個人各自看到哪裡、最後一次收回的時間），
//   和它底下的 msgs/{自動編號} = {from, t, m 字（1～80）或 s 貼圖代號（1～40）}。
//   只有編號裡的那兩個人能讀；送訊息要兩邊都在對方的好友名單裡；from 是本人、時間是伺服器時間；不能改，只能刪自己送的。其他段落沒有動。
// 前面 saves、players 兩段是從薯餅蛋蛋島（毛絨消消樂）的規則原樣複製來的；小窩用 players（好友）、nestSaves（存檔）、nestRooms（公開房間和愛心），saves 用不到。
// 改了規則要再到 Firebase 主控台 → Firestore Database → 規則，整份換掉再按「發布」（見 docs/CLOUD.md）。
// 下面是蛋蛋島原本的說明：
//
// 毛絨消消樂的雲端存檔規則（貼到 Firebase 主控台 → Firestore Database → 規則，見 docs/CLOUD_SAVE.md）
// 2026-11-24 更新：players 可以多一個 look（朋友看得到的薯餅頭像）；saves 可以多一個 closet（衣櫃上雲端）。
// 兩個都是「可以有、不一定要有」，舊版遊戲不寫這兩個欄位也照樣能存。
service cloud.firestore {
  match /databases/{database}/documents {

    // 頭像：最多這幾種部位，每個值是 40 字以內的文字（配件的 id）
    function okLookPart(l, k) {
      return !(k in l) || (l[k] is string && l[k].size() <= 40);
    }
    function okLook(l) {
      return l is map
        && l.keys().hasOnly(['who', 'bg', 'hat', 'outfit', 'ring', 'fx'])
        && okLookPart(l, 'who') && okLookPart(l, 'bg') && okLookPart(l, 'hat')
        && okLookPart(l, 'outfit') && okLookPart(l, 'ring') && okLookPart(l, 'fx');
    }

    // 衣櫃：兌換過的東西、開過的寶箱、正在穿的、頭像選擇、更新時間
    function okCloset(c) {
      return c is map
        && c.keys().hasOnly(['owned', 'chests', 'equip', 'avatar', 't'])
        && (!('owned' in c) || (c.owned is list && c.owned.size() <= 300))
        && (!('chests' in c) || (c.chests is list && c.chests.size() <= 100))
        && (!('equip' in c) || (c.equip is map && c.equip.size() <= 12))
        && (!('avatar' in c) || okLook(c.avatar))
        && (!('t' in c) || c.t is int);
    }

    // 每個玩家一份存檔：saves/{登入帳號的 uid}。只有本人能讀、能寫；別人的存檔看不到也改不了
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // 寫入時檢查格式（只能有這幾個欄位、關卡數合理、大小有限），亂塞資料會被擋
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'unlocked', 'stars', 'best', 'boosters', 't', 'closet'])
        && request.resource.data.unlocked is int
        && request.resource.data.unlocked >= 1 && request.resource.data.unlocked <= 1000
        && request.resource.data.stars is map && request.resource.data.stars.size() <= 1000
        && request.resource.data.best is map && request.resource.data.best.size() <= 1000
        && request.resource.data.boosters is map && request.resource.data.boosters.size() <= 20
        && (!('closet' in request.resource.data) || okCloset(request.resource.data.closet));
    }

    // 好友排行榜的公開資料：players/{登入帳號的 uid}。登入的人都能讀（排行榜、用好友碼找人）；
    // 只有本人能寫，而且只能有這幾個欄位、大小有限。存檔（上面的 saves）還是只有本人看得到
    match /players/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'name', 'stars', 'best', 'friends', 't', 'look'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0 && request.resource.data.stars <= 3000
        && request.resource.data.best is map && request.resource.data.best.size() <= 1000
        && (!('friends' in request.resource.data)
            || (request.resource.data.friends is list && request.resource.data.friends.size() <= 50))
        && (!('t' in request.resource.data) || request.resource.data.t is int)
        && (!('look' in request.resource.data) || okLook(request.resource.data.look));
    }

    // ---------- 薯餅的小窩 ----------
    // 一個房間：牆、地板、擺出來的東西（娃娃和家具）、燈有沒有開
    function okNestRoom(r) {
      return r is map
        && r.keys().hasOnly(['wall', 'floor', 'items', 'light'])
        && r.wall is string && r.wall.size() <= 40
        && r.floor is string && r.floor.size() <= 40
        && r.items is list && r.items.size() <= 300
        && (!('light' in r) || r.light is bool);
    }
    // 整個家：客廳、臥室、浴室一定有；廚房、閣樓（買了才有）可有可無
    // 2026-11-27 小島重做（當天 02:02 已發布）：多收 yard。小島變成可以擺娃娃和家具的戶外房間，公開給朋友看的那份（nestRooms）會帶 home.yard。
    //   自己的存檔（nests）不靠這一條：小島的擺設存在 yard 欄位裡（yard.rm）。
    //   公開房間被擋時會先拿掉 home.yard 再寫（js/cloud.js 的 saveRoom，留著當保險）。
    function okNestHome(h) {
      return h is map && h.keys().hasOnly(['living', 'bed', 'bath', 'kitchen', 'attic', 'yard'])
        && okNestRoom(h.living) && okNestRoom(h.bed) && okNestRoom(h.bath)
        && (!('kitchen' in h) || okNestRoom(h.kitchen))
        && (!('attic' in h) || okNestRoom(h.attic))
        && (!('yard' in h) || okNestRoom(h.yard));
    }
    function okNestCount(m) {
      return m is map && m.size() <= 200;
    }
    // 第二版預留：album（娃娃相簿）、away（你不在的時候）、look（每隻娃娃穿什麼）、closet（擁有的配件）。
    // 第四版加：season（今年送過的節日東西）、mail（信箱）、yard（門外小島）。
    // 賺幣加：earn（小遊戲今天玩了幾局、誰在打工、里程碑領過哪些、小店今天擺什麼）。
    // 先放進白名單，功能做好時不用再發布一次規則。都可有可無，大小上限 200
    function okNestExtra(x) {
      return (x is map || x is list) && x.size() <= 200;
    }
    function okNest(d) {
      return d.keys().hasOnly(['v', 't', 'coins', 'misses', 'wins', 'opened', 'lastDaily', 'seed',
            'dollN', 'furnOwn', 'wallOwn', 'floorOwn', 'wish', 'clawStyle', 'day', 'home', 'uid',
            'album', 'away', 'look', 'closet', 'season', 'mail', 'yard', 'earn'])
        && (!('album' in d) || okNestExtra(d.album))
        && (!('away' in d) || okNestExtra(d.away))
        && (!('look' in d) || okNestExtra(d.look))
        && (!('closet' in d) || okNestExtra(d.closet))
        && (!('season' in d) || okNestExtra(d.season))
        && (!('mail' in d) || okNestExtra(d.mail))
        && (!('yard' in d) || okNestExtra(d.yard))
        && (!('earn' in d) || okNestExtra(d.earn))
        && d.v is int && d.v >= 1 && d.v <= 100
        && d.t is int
        && d.coins is int && d.coins >= 0 && d.coins <= 1000000
        && (!('misses' in d) || d.misses is int)
        && (!('wins' in d) || d.wins is int)
        && (!('uid' in d) || d.uid is int)
        && (!('seed' in d) || d.seed is int)
        && (!('opened' in d) || d.opened is bool)
        && (!('lastDaily' in d) || (d.lastDaily is string && d.lastDaily.size() <= 20))
        && (!('clawStyle' in d) || (d.clawStyle is string && d.clawStyle.size() <= 40))
        && okNestCount(d.dollN) && okNestCount(d.furnOwn) && okNestCount(d.wallOwn) && okNestCount(d.floorOwn)
        && (!('wish' in d) || okNestCount(d.wish))
        && (!('day' in d) || (d.day is map && d.day.size() <= 10))
        && okNestHome(d.home);
    }

    // 小窩的存檔：nestSaves/{登入帳號的 uid}。只有本人能讀、能寫
    match /nestSaves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && okNest(request.resource.data);
    }

    // 去朋友家：nestRooms/{uid}，公開的房間。只放三個房間的擺設、娃娃穿什麼、名字和更新時間（第五版多願望清單和小島的樣子）；
    // 存檔裡的幣、相簿、道具這些都不在這裡。登入的人都能讀，只有本人能寫、能刪
    // 躲貓貓的 hide：d 娃娃的編號、r 房間的編號（都是短的英文字）、f 家具在那一間的編號（整數）、day 哪天躲的（第幾天）
    function okNestHide(h) {
      return h is map
        && h.keys().hasOnly(['d', 'r', 'f', 'day']) && h.keys().hasAll(['d', 'r', 'f', 'day'])
        && h.d is string && h.d.size() >= 1 && h.d.size() <= 12
        && h.r is string && h.r.size() >= 1 && h.r.size() <= 12
        && h.f is int && h.f >= 0 && h.f <= 100000000
        && h.day is int && h.day >= 0 && h.day <= 100000;
    }
    function okNestPublic(d) {
      return d.keys().hasOnly(['name', 'home', 'look', 't', 'want', 'yard', 'hide'])
        // 躲貓貓：hide = 哪一隻娃娃躲在哪一間的哪一件家具後面（可有可無）
        && (!('hide' in d) || okNestHide(d.hide))
        // 第五版：want = 願望清單，最多 3 個娃娃的編號；yard = 小島現在的樣子，只給人看。
        //   小島重做後還是 12 格（這一條不用改）：前 6 格是花圃，後 6 格填空（js/water.js 的 waterPublic）
        && (!('want' in d) || (d.want is list && d.want.size() <= 3))
        && (!('yard' in d) || (d.yard is map && d.yard.keys().hasOnly(['p']) && d.yard.p is list && d.yard.p.size() == 12))
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 24
        && okNestHome(d.home)
        && (!('look' in d) || okNestExtra(d.look))
        && d.t is int;
    }
    match /nestRooms/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && okNestPublic(request.resource.data);
    }

    // a 的好友名單（players/{a}.friends）裡有沒有 b
    function nestFriendOf(a, b) {
      return exists(/databases/$(database)/documents/players/$(a))
        && b in get(/databases/$(database)/documents/players/$(a)).data.get('friends', []);
    }
    // 留在朋友家的愛心：nestRooms/{朋友的 uid}/hearts/{日子_送的人的 uid}
    //   day = 台灣時間（UTC+8）從 1970-01-01 算起的第幾天，要等於今天
    //   文件名字由日子和送的人組成，同一天同一個人只能建一次（不能改、不能刪），所以一人一天一顆
    //   只能留給好友（任一邊加了對方都算），不能留給自己
    //   收到的人只看得到數量和自己的；送的人只能讀自己送的那顆（確認今天送過沒）
    match /nestRooms/{uid}/hearts/{hid} {
      allow get: if request.auth != null
        && (request.auth.uid == uid || hid.split('_')[1] == request.auth.uid);
      allow list: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['from', 'day'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.day is int
        && request.resource.data.day * 86400000 - 28800000 <= request.time.toMillis()
        && request.time.toMillis() < (request.resource.data.day + 1) * 86400000 - 28800000
        && hid == string(request.resource.data.day) + '_' + request.auth.uid
        && (nestFriendOf(uid, request.auth.uid) || nestFriendOf(request.auth.uid, uid));
    }

    // 送娃娃：nestGifts/{自動編號}，一筆是一隻在朋友門口等的娃娃
    //   from 寄的人（一定是本人）、to 收的人（不能是自己，要是好友，任一邊加了對方都算）
    //   doll 哪一隻、line 第幾句話（0–5）、fromName / toName 顯示用的名字、t 寄出時間
    //   寄的人和收的人都讀得到；收的人按「讓牠進來」或寄的人「收回」時刪掉。寄出後不能改
    //   讀一筆已經不在的（對方剛領走或收回），也要能讀到「不存在」，所以 resource == null 放行
    //   一天送幾次、門口幾隻，只在遊戲畫面上擋，這裡不檢查
    match /nestGifts/{gid} {
      allow get: if request.auth != null
        && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'doll', 'line', 't', 'msg'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'to', 'doll', 'line', 't'])
        // 第五版：msg = 自己打的一句話，可以不填，40 字以內
        && (!('msg' in request.resource.data)
            || (request.resource.data.msg is string && request.resource.data.msg.size() <= 40))
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.doll is string && request.resource.data.doll.size() <= 20
        && request.resource.data.line is int
        && request.resource.data.line >= 0 && request.resource.data.line <= 5
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() >= 1 && request.resource.data.fromName.size() <= 24
        && (!('toName' in request.resource.data)
            || (request.resource.data.toName is string && request.resource.data.toName.size() <= 24))
        && request.resource.data.t is int
        // 有自己打的字（msg）：收的人的名單裡要有寄的人。只選寫好的句子：任一邊加了對方就可以
        && (nestFriendOf(request.resource.data.to, request.resource.data.from)
            || (!('msg' in request.resource.data)
                && nestFriendOf(request.resource.data.from, request.resource.data.to)));
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if false;
    }

    // ---------- 第五版：朋友之間的玩法 ----------
    // a 和 b 是不是朋友：任一邊的好友名單裡有對方就算（跟愛心、送娃娃一樣）
    function nestFriends(a, b) {
      return nestFriendOf(a, b) || nestFriendOf(b, a);
    }
    // day 是不是今天：台灣時間（UTC+8）從 1970-01-01 算起的第幾天（跟愛心一樣的算法）
    function nestToday(day) {
      return day is int
        && day * 86400000 - 28800000 <= request.time.toMillis()
        && request.time.toMillis() < (day + 1) * 86400000 - 28800000;
    }
    function okNestName(n) {
      return n is string && n.size() >= 1 && n.size() <= 24;
    }

    // 訪客簿：nestRooms/{主人}/book/{日子_寫的人}
    //   只有「主人自己加過的好友」能寫（主人的名單裡有他），不能寫在自己家；文件名字由今天和寫的人組成，所以一人一天一則
    //   sticker 貼紙的編號；msg 自己打的一句話，可以不填，40 字以內
    //   主人和主人加過的好友都讀得到（訪客簿的字，來家裡的朋友都看得到）；寫的人另外可以讀自己那一則
    //   主人可以刪任何一則，寫的人可以刪自己的；寫了不能改
    match /nestRooms/{uid}/book/{bid} {
      allow get: if request.auth != null
        && (request.auth.uid == uid || nestFriendOf(uid, request.auth.uid) || bid.split('_')[1] == request.auth.uid);
      allow list: if request.auth != null
        && (request.auth.uid == uid || nestFriendOf(uid, request.auth.uid));
      allow create: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'day', 'sticker', 'msg'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'day', 'sticker'])
        && request.resource.data.from == request.auth.uid
        && okNestName(request.resource.data.fromName)
        && nestToday(request.resource.data.day)
        && bid == string(request.resource.data.day) + '_' + request.auth.uid
        && request.resource.data.sticker is string
        && request.resource.data.sticker.size() >= 1 && request.resource.data.sticker.size() <= 40
        && (!('msg' in request.resource.data)
            || (request.resource.data.msg is string && request.resource.data.msg.size() <= 40))
        && nestFriendOf(uid, request.auth.uid);
      allow delete: if request.auth != null
        && (request.auth.uid == uid || resource.data.from == request.auth.uid);
      allow update: if false;
    }

    // 幫朋友的小島澆水：nestRooms/{主人}/water/{日子_澆的人}
    //   只有主人的朋友能寫，一人一天一次；plot 是花圃的第幾格（0～5；小島重做前是 0～11，2026-11-27 改，已發布）
    //   主人讀得到全部（打開遊戲時套用到自己的存檔，再刪掉）；澆的人只能確認自己今天那一筆在不在
    match /nestRooms/{uid}/water/{wid} {
      allow get: if request.auth != null
        && (request.auth.uid == uid || wid.split('_')[1] == request.auth.uid);
      allow list: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'day', 'plot'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'day', 'plot'])
        && request.resource.data.from == request.auth.uid
        && okNestName(request.resource.data.fromName)
        && nestToday(request.resource.data.day)
        && wid == string(request.resource.data.day) + '_' + request.auth.uid
        && request.resource.data.plot is int
        && request.resource.data.plot >= 0 && request.resource.data.plot <= 5
        && nestFriends(uid, request.auth.uid);
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    // 躲貓貓找的結果：nestRooms/{主人}/found/{日子_找的人}（寫法跟上面的澆水一樣）
    //   只有主人的朋友能寫，不能寫在自己家；文件名字由今天和找的人組成，所以一人一天一筆，寫了不能改
    //   ok 有沒有找到（布林）、n 用了幾次（整數 1～3）
    //   主人讀得到全部（打開遊戲時看誰來找過，再刪掉）；找的人只能確認自己今天那一筆在不在
    match /nestRooms/{uid}/found/{fid} {
      allow get: if request.auth != null
        && (request.auth.uid == uid || fid.split('_')[1] == request.auth.uid);
      allow list: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'day', 'ok', 'n'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'day', 'ok', 'n'])
        && request.resource.data.from == request.auth.uid
        && okNestName(request.resource.data.fromName)
        && nestToday(request.resource.data.day)
        && fid == string(request.resource.data.day) + '_' + request.auth.uid
        && request.resource.data.ok is bool
        && request.resource.data.n is int
        && request.resource.data.n >= 1 && request.resource.data.n <= 3
        && nestFriends(uid, request.auth.uid);
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    // 娃娃去朋友家過夜：nestStays/{出門的人的 uid}，一人一筆，所以一次只能有一隻在外面
    //   from 出門的人（一定是本人）、to 主人（要是朋友、不能是自己）、doll 哪一隻、look 穿什麼、day 出門那天（要是今天）
    //   note 主人塞的小紙條：出門時一定是空的，只有主人能寫，40 字以內；x、y 在主人客廳的位置（0～100）
    //   出門的人能建立、能刪（回家）；主人只能改 note、x、y，也能刪（送牠回家）；兩邊都讀得到
    //   讀一筆不存在的（已經回家）要能讀到「不存在」，所以 resource == null 放行
    function okStayPos(d) {
      return (d.x is int || d.x is float) && d.x >= 0 && d.x <= 100
        && (d.y is int || d.y is float) && d.y >= 0 && d.y <= 100;
    }
    match /nestStays/{sid} {
      allow get: if request.auth != null
        && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && sid == request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'doll', 'look', 'day', 'note', 'x', 'y'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'to', 'doll', 'look', 'day', 'note', 'x', 'y'])
        && request.resource.data.from == request.auth.uid
        && okNestName(request.resource.data.fromName)
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.doll is string
        && request.resource.data.doll.size() >= 1 && request.resource.data.doll.size() <= 20
        && request.resource.data.look is map && request.resource.data.look.size() <= 4
        && nestToday(request.resource.data.day)
        && request.resource.data.note is string && request.resource.data.note.size() == 0
        && okStayPos(request.resource.data)
        && nestFriends(request.auth.uid, request.resource.data.to);
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'x', 'y'])
        && request.resource.data.note is string && request.resource.data.note.size() <= 40
        && okStayPos(request.resource.data);
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // 明信片：nestCards/{自動編號}
    //   不放圖片，放那一間房間的擺法 snap = {rid 哪一間, room 擺設（檢查跟公開房間的一間一樣）, look 娃娃穿什麼, night 是不是晚上}
    //   msg 自己打的一句話，80 字以內
    //   寄的人必須是本人、不能寄給自己，收的人自己的好友名單裡要有寄的人；寄的人和收的人都讀得到、都能刪；寄出後不能改
    //   一天寄幾張只在遊戲畫面上擋，這裡不檢查
    function okCardSnap(s) {
      return s is map
        && s.keys().hasOnly(['rid', 'room', 'look', 'night'])
        && s.keys().hasAll(['rid', 'room'])
        && s.rid is string && s.rid.size() <= 10
        && okNestRoom(s.room)
        && (!('look' in s) || (s.look is map && s.look.size() <= 60))
        && (!('night' in s) || s.night is bool);
    }
    match /nestCards/{cid} {
      allow get: if request.auth != null
        && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'snap', 'msg', 't'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'to', 'snap', 'msg', 't'])
        && request.resource.data.from == request.auth.uid
        && okNestName(request.resource.data.fromName)
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && okCardSnap(request.resource.data.snap)
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 80
        && request.resource.data.t is int
        && nestFriendOf(request.resource.data.to, request.resource.data.from);
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if false;
    }

    // 回信：nestLetters/{自動編號}（2026-11-27 20:18 已發布）
    //   msg 自己打的字，1～100 字；只有字，沒有圖
    //   re 回的是哪一種：gift（送來的娃娃）、trip（過夜的日記）、pc（明信片）、re（回信），沒在回哪一封就不填
    //   d 回的是哪一隻娃娃的信，12 字以內，可以不填
    //   寄的人必須是本人、不能寄給自己，收的人自己的好友名單裡要有寄的人；寄的人和收的人都讀得到、都能刪；寄出後不能改
    //   一天寄幾封只在遊戲畫面上擋，這裡不檢查
    match /nestLetters/{lid} {
      allow get: if request.auth != null
        && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'msg', 're', 'd', 't'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'to', 'msg', 't'])
        && request.resource.data.from == request.auth.uid
        && okNestName(request.resource.data.fromName)
        && request.resource.data.to is string && request.resource.data.to.size() <= 64
        && request.resource.data.to != request.auth.uid
        && request.resource.data.msg is string
        && request.resource.data.msg.size() >= 1 && request.resource.data.msg.size() <= 100
        && (!('re' in request.resource.data) || request.resource.data.re in ['gift', 'trip', 'pc', 're'])
        && (!('d' in request.resource.data) || (request.resource.data.d is string && request.resource.data.d.size() <= 12))
        && request.resource.data.t is int
        && nestFriendOf(request.resource.data.to, request.resource.data.from);
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if false;
    }

    // ---------- 全部都留（2026-11-27 14:50 已發布）----------
    // 整份存檔是一份文件（nestSaves/{uid}，上限 1 MiB），紀念冊、收到的明信片、信箱的信不能無限放在裡面。
    // 主存檔只留最近的（紀念冊 200 筆、明信片 30 張、信箱每一類 60 封），較舊的搬到存檔底下的三個子集合：
    //   nestSaves/{uid}/memo/{月份}  = {l: [那個月的紀念冊紀錄], t: 更新時間}
    //   nestSaves/{uid}/mail/{月份}  = {l: [那個月的信], t: 更新時間}
    //   nestSaves/{uid}/cards/{明信片編號} = 一張明信片（一張比較大，一張一份文件）
    // 三個都只有本人能讀、能寫、能刪；別人（包括好友）看不到。平常打開遊戲不讀，按「看更早的」或點到舊的那一筆才讀。
    // 月份的文件名字：yyyy-mm，同一個月太多放不下時接 -2 ～ -9（例：2026-11、2026-11-2）。
    //   年份從 2026 到現在這一年，月份 01 ～ 12：不能寫未來的月份，一個帳號能開的文件數量有上限。
    // 規則沒有迴圈，清單裡每一筆的欄位驗不到，只能驗：只有 l 和 t 兩欄、l 是清單、筆數上限、t 是整數；
    //   另外抽查清單的第一筆和最後一筆是不是一筆紀錄的樣子（有編號、有日期、長度在範圍內）。
    //   資料只有本人讀得到，亂寫只會弄壞自己的舊紀錄；整份文件的大小 Firestore 自己擋在 1 MiB。
    function okKeepMonth(mid) {
      return mid.matches('^20[0-9]{2}-(0[1-9]|1[0-2])(-[2-9])?$')
        && int(mid.split('-')[0]) >= 2026
        && int(mid.split('-')[0]) <= request.time.year();
    }
    // 紀念冊的一筆：{id, t:'日期', ts, u:朋友的帳號, n:朋友的名字, k:哪一種, in, d:娃娃, m:對方寫的字, c:明信片編號}
    function okMemoRow(e) {
      return e is map
        && e.keys().hasOnly(['id', 't', 'ts', 'u', 'n', 'k', 'in', 'd', 'm', 'c'])
        && e.id is string && e.id.size() >= 1 && e.id.size() <= 80
        && e.t is string && e.t.size() <= 10
        && e.u is string && e.u.size() <= 64
        && e.k is string && e.k.size() <= 20
        && (!('n' in e) || (e.n is string && e.n.size() <= 24))
        && (!('m' in e) || (e.m is string && e.m.size() <= 80))
        && (!('c' in e) || (e.c is string && e.c.size() <= 80))
        && (!('d' in e) || (e.d is string && e.d.size() <= 20));
    }
    // 信箱的一封：{k:信的代號（朋友打的字、AI 寫的字編碼後也在裡面）, t:'日期', r:看過, a:附件, g:附件領了, f:龍龍的葉子翻過了}
    function okMailRow(o) {
      return o is map
        && o.keys().hasOnly(['k', 't', 'r', 'a', 'g', 'f'])
        && o.k is string && o.k.size() >= 3 && o.k.size() <= 6000
        && o.t is string && o.t.size() <= 10
        && (!('a' in o) || o.a == null || (o.a is string && o.a.size() <= 40));
    }
    function okKeepDoc(d, max) {
      return d.keys().hasOnly(['l', 't']) && d.keys().hasAll(['l', 't'])
        && d.l is list && d.l.size() >= 1 && d.l.size() <= max
        && d.t is int;
    }
    match /nestSaves/{uid}/memo/{mid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && okKeepMonth(mid)
        && okKeepDoc(request.resource.data, 1000)
        && okMemoRow(request.resource.data.l[0])
        && okMemoRow(request.resource.data.l[request.resource.data.l.size() - 1]);
    }
    match /nestSaves/{uid}/mail/{mid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && okKeepMonth(mid)
        && okKeepDoc(request.resource.data, 500)
        && okMailRow(request.resource.data.l[0])
        && okMailRow(request.resource.data.l[request.resource.data.l.size() - 1]);
    }
    // 收到的明信片：一張一份，文件名字就是明信片的編號。內容跟主存檔 mail.pc 裡的一張一樣，快照沿用 okCardSnap
    //   {id 編號, w 寄的人的名字, t '日期', msg 寫的字（80 字以內）, snap 房間的快照, r 看過了沒, u 寄的人的帳號（舊的明信片沒有）}
    match /nestSaves/{uid}/cards/{cid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && cid.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.keys().hasOnly(['id', 'w', 't', 'msg', 'snap', 'r', 'u'])
        && request.resource.data.keys().hasAll(['id', 'w', 't', 'snap'])
        && request.resource.data.id == cid
        && request.resource.data.w is string && request.resource.data.w.size() <= 24
        && request.resource.data.t is string && request.resource.data.t.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('msg' in request.resource.data) || (request.resource.data.msg is string && request.resource.data.msg.size() <= 80))
        && okCardSnap(request.resource.data.snap)
        && (!('r' in request.resource.data) || request.resource.data.r is int)
        && (!('u' in request.resource.data) || (request.resource.data.u is string && request.resource.data.u.size() <= 64));
    }

    // 朋友聊天：nestChats/{cid}，cid = 兩個人的帳號排序後用 _ 接起來（帳號裡沒有 _），例如 aaa_bbb
    //   u  = 那兩個帳號（跟 cid 拆開來一樣）
    //   t  = 最後一則的時間、f = 最後一則誰送的：只有送訊息的時候改，t 要是伺服器時間、f 是本人，而且兩邊都要在對方的好友名單裡
    //   sa = 排前面那個人看到哪裡、sb = 排後面那個人：各自只能改自己的，值是伺服器時間
    //   x  = 最後一次收回訊息的時間（伺服器時間），對方開著聊天頁時看到它變了會重讀
    //   只有這兩個人讀得到；不能刪
    function chatMe(cid) {
      return request.auth != null
        && cid.split('_').size() == 2
        && cid.split('_')[0] < cid.split('_')[1]
        && request.auth.uid in cid.split('_');
    }
    function chatFriends(cid) {
      return nestFriendOf(cid.split('_')[0], cid.split('_')[1]) && nestFriendOf(cid.split('_')[1], cid.split('_')[0]);
    }
    function chatSide(cid) {
      return request.auth.uid == cid.split('_')[0] ? 'sa' : 'sb';
    }
    // ch：這次改到的欄位
    function chatMetaOk(cid, ch) {
      let d = request.resource.data;
      return d.keys().hasOnly(['u', 't', 'f', 'sa', 'sb', 'x'])
        && d.u == cid.split('_')
        && ch.hasOnly(['u', 't', 'f', 'x', chatSide(cid)])
        && (!ch.hasAny(['t', 'f']) || (d.t == request.time && d.f == request.auth.uid && chatFriends(cid)))
        && (!ch.hasAny([chatSide(cid)]) || d[chatSide(cid)] == request.time)
        && (!ch.hasAny(['x']) || d.x == request.time);
    }
    match /nestChats/{cid} {
      allow get: if chatMe(cid);
      allow list: if request.auth != null && request.auth.uid in resource.data.u;
      allow create: if chatMe(cid) && chatMetaOk(cid, request.resource.data.keys());
      allow update: if chatMe(cid) && chatMetaOk(cid, request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;

      // 一則訊息：from 送的人、t 伺服器時間，m（字，1～80）和 s（貼圖代號，1～40）只能有一個
      match /msgs/{mid} {
        allow read: if chatMe(cid);
        allow create: if chatMe(cid) && chatFriends(cid)
          && request.resource.data.keys().hasOnly(['from', 't', 'm', 's'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.t == request.time
          && ((request.resource.data.keys().hasAll(['m']) && !request.resource.data.keys().hasAny(['s'])
                && request.resource.data.m is string && request.resource.data.m.size() >= 1 && request.resource.data.m.size() <= 80)
            || (request.resource.data.keys().hasAll(['s']) && !request.resource.data.keys().hasAny(['m'])
                && request.resource.data.s is string && request.resource.data.s.size() >= 1 && request.resource.data.s.size() <= 40));
        allow delete: if chatMe(cid) && resource.data.from == request.auth.uid;
        allow update: if false;
      }
    }

    // 其他東西一律不能讀寫
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
